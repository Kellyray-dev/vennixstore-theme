        {% endif %}
        <div class="ai-magazine-overlay-{{ ai_gen_id }}">
          {% if block.settings.featured_category != blank %}
            <div class="ai-magazine-category-{{ ai_gen_id }}">{{ block.settings.featured_category }}</div>
          {% endif %}
          {% if block.settings.featured_title != blank %}
            <h2 class="ai-magazine-title-{{ ai_gen_id }}">{{ block.settings.featured_title }}</h2>
          {% endif %}
          {% if block.settings.featured_excerpt != blank %}
            <div class="ai-magazine-excerpt-{{ ai_gen_id }}">{{ block.settings.featured_excerpt }}</div>
          {% endif %}
          {% if block.settings.show_meta %}
            <div class="ai-magazine-meta-{{ ai_gen_id }}">
