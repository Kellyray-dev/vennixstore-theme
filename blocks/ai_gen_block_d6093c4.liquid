{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-magazine-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-magazine-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-magazine-item-{{ ai_gen_id }}--featured {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ai-magazine-item-{{ ai_gen_id }}--secondary {
    grid-column: span 4;
  }

  .ai-magazine-item-{{ ai_gen_id }}--tertiary {
    grid-column: span 4;
  }

  .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    overflow: hidden;
  }

  .ai-magazine-item-{{ ai_gen_id }}--featured .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    min-height: {{ block.settings.featured_min_height }}px;
  }

  .ai-magazine-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-magazine-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-magazine-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    color: {{ block.settings.text_color }};
    z-index: 2;
  }

  .ai-magazine-category-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.category_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
  }

  .ai-magazine-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-magazine-item-{{ ai_gen_id }}--featured .ai-magazine-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
  }

  .ai-magazine-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.5;
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.9;
  }

  .ai-magazine-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-magazine-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .ai-magazine-item-{{ ai_gen_id }}:hover .ai-magazine-image-{{ ai_gen_id }} {
    transform: scale(1.05);
    transition: transform 0.6s ease;
  }

  .ai-magazine-image-{{ ai_gen_id }} {
    transition: transform 0.6s ease;
  }

  @media screen and (max-width: 989px) {
    .ai-magazine-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(6, 1fr);
      gap: {{ block.settings.mobile_grid_gap }}px;
    }

    .ai-magazine-item-{{ ai_gen_id }}--featured {
      grid-column: span 6;
      grid-row: span 1;
    }

    .ai-magazine-item-{{ ai_gen_id }}--secondary {
      grid-column: span 6;
    }

    .ai-magazine-item-{{ ai_gen_id }}--tertiary {
      grid-column: span 6;
    }

    .ai-magazine-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-magazine-item-{{ ai_gen_id }}--featured .ai-magazine-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_title_size | times: 0.7 }}px;
    }

    .ai-magazine-overlay-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-magazine-item-{{ ai_gen_id }}--featured,
    .ai-magazine-item-{{ ai_gen_id }}--secondary,
    .ai-magazine-item-{{ ai_gen_id }}--tertiary {
      grid-column: span 1;
    }
  }
{% endstyle %}

<div class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
