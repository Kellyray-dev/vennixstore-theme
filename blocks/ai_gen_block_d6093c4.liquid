              {% endif %}
              {% if block.settings.featured_date != blank %}
                <span>{{ block.settings.featured_date }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>
        {% if block.settings.featured_link != blank %}
          <a href="{{ block.settings.featured_link }}" class="ai-magazine-link-{{ ai_gen_id }}" aria-label="{{ block.settings.featured_title | escape }}"></a>
