{% doc %}
  @prompt
    Create a Product Catalog section that reads from a metaobject of type "accessories" (Product catalog). The section should display the catalog's title, description, a cover image, and a grid of linked product cards showing product image, title, and price. Include an "Is Featured" option that adds a highlighted banner or badge when enabled. The section should be customizable in the theme editor and work on the homepage or any page template.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if block.settings.catalog_metaobject %}
  {% assign catalog = block.settings.catalog_metaobject %}
  {% assign catalog_title = catalog.title.value %}
  {% assign catalog_description = catalog.description.value %}
  {% assign catalog_cover_image = catalog.cover_image.value %}
  {% assign catalog_products = catalog.products.value %}
{% endif %}

{% style %}
  .ai-product-catalog-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-catalog__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-catalog__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
    position: relative;
  }

  .ai-product-catalog__featured-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.featured_badge_bg }};
    color: {{ block.settings.featured_badge_color }};
    padding: 8px 16px;
    border-radius: {{ block.settings.featured_badge_radius }}px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-catalog__cover-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.header_spacing }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-catalog__cover-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-catalog__cover-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-catalog__cover-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-catalog__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-product-catalog__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-product-catalog__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-product-catalog__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-product-catalog__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-product-catalog__card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-catalog__card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-catalog__card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-catalog__card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-catalog__card-content-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-product-catalog__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-product-catalog__card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 700;
    margin-top: auto;
  }

  .ai-product-catalog__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background-color: #f9f9f9;
    border-radius: {{ block.settings.card_border_radius }}px;
    color: #666;
  }

  .ai-product-catalog__empty-state-{{ ai_gen_id }} h3 {
    font-size: 20px;
    margin: 0 0 8px;
    color: #333;
  }

  .ai-product-catalog__empty-state-{{ ai_gen_id }} p {
    font-size: 14px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-product-catalog__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-catalog__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-catalog__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-product-catalog__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<product-catalog-{{ ai_gen_id }} class="ai-product-catalog-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-catalog__container-{{ ai_gen_id }}">
    {% if block.settings.catalog_metaobject %}
      <div class="ai-product-catalog__header-{{ ai_gen_id }}">
        {% if block.settings.show_featured_badge %}
          <div class="ai-product-catalog__featured-badge-{{ ai_gen_id }}">
            {{ block.settings.badge_label }}
          </div>
        {% endif %}

        {% if block.settings.show_cover_image %}
          {% if catalog_cover_image %}
            <div class="ai-product-catalog__cover-image-{{ ai_gen_id }}">
              <img
                src="{{ catalog_cover_image | image_url: width: 1500 }}"
                alt="{{ catalog_title | escape }}"
                loading="lazy"
                width="{{ catalog_cover_image.width }}"
                height="{{ catalog_cover_image.height }}"
              >
            </div>
          {% else %}
            <div class="ai-product-catalog__cover-placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% endif %}

        {% if block.settings.show_title and catalog_title %}
          <h2 class="ai-product-catalog__title-{{ ai_gen_id }}">{{ catalog_title }}</h2>
        {% endif %}

        {% if block.settings.show_description and catalog_description %}
          <div class="ai-product-catalog__description-{{ ai_gen_id }}">{{ catalog_description }}</div>
        {% endif %}
      </div>

      {% if catalog_products and catalog_products.size > 0 %}
        <div class="ai-product-catalog__grid-{{ ai_gen_id }}">
          {% for product in catalog_products %}
            <a href="{{ product.url }}" class="ai-product-catalog__card-{{ ai_gen_id }}">
              <div class="ai-product-catalog__card-image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-product-catalog__card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-product-catalog__card-content-{{ ai_gen_id }}">
                <h3 class="ai-product-catalog__card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                <div class="ai-product-catalog__card-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-product-catalog__empty-state-{{ ai_gen_id }}">
          <h3>No products in this catalog</h3>
          <p>Add products to your metaobject to display them here</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-product-catalog__empty-state-{{ ai_gen_id }}">
        <h3>Select a product catalog</h3>
        <p>Choose an accessories metaobject from the block settings to get started</p>
      </div>
    {% endif %}
  </div>
</product-catalog-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCatalog{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const cards = this.querySelectorAll('.ai-product-catalog__card-{{ ai_gen_id }}');
        cards.forEach(card => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('product-catalog-{{ ai_gen_id }}', ProductCatalog{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product catalog",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Catalog source"
    },
    {
      "type": "metaobject",
      "id": "catalog_metaobject",
      "label": "Product catalog",
      "metaobject_type": "accessories"
    },
    {
      "type": "header",
      "content": "Featured badge"
    },
    {
      "type": "checkbox",
      "id": "show_featured_badge",
      "label": "Show featured badge",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "default": "Featured"
    },
    {
      "type": "color",
      "id": "featured_badge_bg",
      "label": "Badge background",
      "default": "#334fb4"
    },
    {
      "type": "color",
      "id": "featured_badge_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "featured_badge_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Badge border radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Catalog header"
    },
    {
      "type": "checkbox",
      "id": "show_cover_image",
      "label": "Show cover image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Header spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on tablet",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "grid_spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Grid top spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Product title size",
      "default": 16
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "product_price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Product price size",
      "default": 16
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Product price color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Max container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product catalog"
    }
  ]
}
{% endschema %}
