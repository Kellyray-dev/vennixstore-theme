{
  "sections": {
    "banner": {
      "type": "collection-hero",
      "settings": {
        "show_title": true,
        "show_description": true,
        "show_cta": true,
        "cta_label": "Shop the collection",
        "handle_map": "tech=collection-hero-tech.jpg\nhome=collection-hero-home.jpg\naccessories=collection-hero-accessories.jpg\napparel=collection-hero-apparel.jpg\nbeauty=collection-hero-beauty.jpg",
        "overlay_opacity": 35,
        "text_alignment": "left",
        "color_scheme": "scheme-2"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "quick_add": "standard",
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 52,
        "padding_bottom": 84
      }
    }
  },
  "order": [
    "banner",
    "product-grid"
  ]
}
