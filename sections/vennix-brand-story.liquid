<script src="{{ 'vennix-motion.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ---- Editorial brand story ---------------------------------------------
     Asymmetric 60/40 composition on desktop: image left, copy pulled
     off-axis on the right; clean single column on mobile. */
  .vx-story__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.8rem, 5vw, 4.8rem);
  }

  @media screen and (min-width: 990px) {
    .vx-story__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: clamp(5rem, 8vw, 9.6rem);
      align-items: start;
    }
  }

  .vx-story__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--v-neutral-warm);
  }

  .vx-story__media > img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* Content column offset below the image top edge — quiet asymmetry. */
  .vx-story__content {
    max-width: 50rem;
  }

  @media screen and (min-width: 990px) {
    .vx-story__content {
      padding-top: clamp(3rem, 6vh, 6.5rem);
    }
  }

  .vx-story__eyebrow {
    margin: 0 0 1.6rem;
    color: #765b2a;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .vx-story__heading {
    margin: 0;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 4.2vw, 5.2rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .vx-story__text {
    margin: 2.2rem 0 0;
    color: rgba(var(--color-foreground), 0.68);
    font-size: var(--vennix-type-lead, 1.6rem);
    line-height: 1.7;
  }

  .vx-story__text p {
    margin: 0 0 1.4rem;
    color: inherit;
  }

  .vx-story__text p:last-child {
    margin-bottom: 0;
  }

  .vx-story__button {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 5rem;
    margin-top: 3.2rem;
  }

  .vx-story__button svg {
    width: 1.6rem;
    height: 1.6rem;
    transition: transform var(--vennix-motion-duration-fast, 240ms) var(--vennix-motion-ease, cubic-bezier(0.22, 0.61, 0.36, 1));
  }

  .vx-story__button:hover svg,
  .vx-story__button:focus-visible svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 989px) {
    .vx-story__media {
      order: -1;
    }
  }

  @media screen and (max-width: 749px) {
    .vx-story__grid {
      gap: 3rem;
    }

    .vx-story__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vx-story__button svg {
      transition: none;
      transform: none;
    }
  }
{%- endstyle -%}

<section
  class="vx-story color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  {%- if section.settings.heading != blank %} aria-labelledby="VennixStoryHeading-{{ section.id }}"{% endif %}
  data-vx-motion="{{ section.settings.enable_entrance_animation }}"
  style="--vennix-motion-duration: {{ section.settings.motion_duration }}ms;"
>
  <div class="page-width">
    <div class="vx-story__grid">
      <div class="vx-rise" style="--vx-index: 0">
        <div
          class="vx-story__media"
          data-vx-parallax="{{ section.settings.enable_parallax }}"
        >
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '500, 800, 1100, 1600',
                sizes: '(min-width: 990px) calc((100vw - 16rem) * 0.53), 100vw',
                loading: 'lazy',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- elsif section.settings.image_asset != blank -%}
            <img
              src="{{ section.settings.image_asset | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              width="1408"
              height="768"
            >
          {%- else -%}
            {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <div class="vx-story__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vx-section-eyebrow vx-rise" style="--vx-index: 0">
            <span class="vx-section-eyebrow__mark" aria-hidden="true"></span>
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="VennixStoryHeading-{{ section.id }}" class="vx-story__heading vx-rise" style="--vx-index: 1">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="vx-story__text rte vx-rise" style="--vx-index: 2">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            class="button button--primary vx-story__button vx-rise"
            style="--vx-index: 3"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            <span>{{ section.settings.button_label | escape }}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
              <path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vennix brand story",
  "tag": "section",
  "class": "section section--vennix-story",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Placeholder — replace with your own photography."
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Bundled image",
      "default": "activewear.jpg",
      "info": "Used when no image is selected. Enter an asset filename from the theme's assets folder. Placeholder — replace with your own photography."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Vennix difference" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Why VennixStore" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Performance inspired everyday pieces built for modern movement — from morning runs to evening plans.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Active Wear" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "enable_entrance_animation",
      "label": "Enable entrance animation",
      "default": true,
      "info": "Fade-and-rise reveal for the imagery and copy. Disabled automatically for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "motion_duration",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "label": "Animation duration",
      "default": 560
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable image parallax",
      "default": true,
      "info": "A gentle scale-drift on the image while scrolling. Desktop only; disabled automatically for visitors who prefer reduced motion."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Vennix brand story"
    }
  ]
}
{% endschema %}
