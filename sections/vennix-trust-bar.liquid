<script src="{{ 'vennix-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign free_shipping_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros

  comment
    A badge bound to the global free-shipping message disappears when the merchant turns
    the promotion off, so count what will actually render before emitting the section
    shell — otherwise an all-shipping trust bar leaves an empty full-width band behind.
  endcomment
  assign visible_badges = 0
  for block in section.blocks
    if block.settings.use_free_shipping_message == false or settings.free_shipping_enabled != false
      assign visible_badges = visible_badges | plus: 1
    endif
  endfor
-%}

{%- if visible_badges > 0 -%}
<section
  class="vx-trust color-{{ section.settings.color_scheme }} gradient"
  aria-label="Shopping benefits"
  data-vx-motion="{{ section.settings.enable_entrance_animation }}"
  style="--vennix-motion-duration: {{ section.settings.motion_duration }}ms;"
>
  <ul class="vx-trust__grid page-width" role="list">
    {%- for block in section.blocks -%}
      {%- unless block.settings.use_free_shipping_message and settings.free_shipping_enabled == false -%}
      <li
        class="vx-trust__item vx-rise"
        style="--vx-index: {{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <span class="vx-trust__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'delivery' -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            {%- when 'returns' -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M8 7H4V3M4.5 7.5A8 8 0 1 1 4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- when 'support' -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.4"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- endcase -%}
        </span>
        <span class="vx-trust__copy">
          <strong>
            {%- if block.settings.use_free_shipping_message -%}
              {{ settings.free_shipping_message | escape | replace: '[threshold]', free_shipping_amount }}
            {%- else -%}
              {{ block.settings.title | escape | replace: '[threshold]', free_shipping_amount }}
            {%- endif -%}
          </strong>
          {%- if block.settings.description != blank -%}<small>{{ block.settings.description | escape | replace: '[threshold]', free_shipping_amount }}</small>{%- endif -%}
        </span>
      </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Vennix trust bar",
  "tag": "section",
  "class": "section section--vennix-trust",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "enable_entrance_animation",
      "label": "Enable entrance animation",
      "default": true,
      "info": "Subtle staggered fade-in as the bar scrolls into view. Disabled automatically for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "motion_duration",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "label": "Animation duration",
      "default": 550
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Shopping benefit",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "support", "label": "Support" }
          ],
          "default": "secure"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure checkout",
          "info": "Use [threshold] to insert the free-shipping threshold from Theme settings > Cart."
        },
        {
          "type": "checkbox",
          "id": "use_free_shipping_message",
          "label": "Use global free-shipping message",
          "default": false
        },
        { "type": "text", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vennix trust bar",
      "blocks": [
        { "type": "badge", "settings": { "icon": "delivery", "title": "Free shipping on orders over [threshold]", "use_free_shipping_message": true, "description": "" } },
        { "type": "badge", "settings": { "icon": "returns", "title": "30-day returns", "description": "Clear return window" } },
        { "type": "badge", "settings": { "icon": "secure", "title": "Secure checkout", "description": "Protected payments" } }
      ]
    }
  ]
}
{% endschema %}
