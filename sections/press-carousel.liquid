{{ 'section-press-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vennix-press.js' | asset_url }}" defer="defer"></script>

<section class="vx-press color-{{ section.settings.color_scheme }} gradient" aria-label="{{ section.settings.heading | default: 'As seen in' | escape }}">
  <div class="vx-press__inner page-width">
    {%- if section.settings.heading != blank -%}
      <p class="vx-press__heading">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <vennix-press>
        <div class="vx-press__viewport" data-press-viewport tabindex="0">
        <ul class="vx-press__track" data-press-track role="list" style="--vx-press-duration: {{ section.settings.speed }}s;">
          {%- for block in section.blocks -%}
            <li class="vx-press__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="vx-press__logo" href="{{ block.settings.link }}" target="_blank" rel="noopener">
              {%- else -%}
                <span class="vx-press__logo">
              {%- endif -%}
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag:
                    widths: '160, 240, 320, 400',
                    sizes: '160px',
                    loading: 'lazy',
                    alt: block.settings.logo.alt | default: block.settings.name | default: 'Press logo'
                }}
              {%- else -%}
                <span class="vx-press__placeholder">{{ block.settings.name | default: 'Logo' | escape }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        </div>
      </vennix-press>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Press carousel",
  "tag": "section",
  "class": "section section--press-carousel",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen in"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Loop duration",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Publication name",
          "info": "Used as fallback text and alt description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press carousel",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
