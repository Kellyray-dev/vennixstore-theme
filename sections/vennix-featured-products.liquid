{{ 'vennix-brand.css' | asset_url | stylesheet_tag }}

<section style="padding:80px 20px;background:{{ section.settings.bg_color }};">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="vx-heading" style="font-size:clamp(28px,4vw,40px);margin-top:8px;">{{ section.settings.heading }}</h2>
      <p style="color:#9CA3AF;font-family:'Inter',sans-serif;margin-top:12px;font-size:15px;">{{ section.settings.subtext }}</p>
    </div>

    <div class="vx-prod-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% for product in collection.products limit: section.settings.product_limit %}
        <a href="{{ product.url }}" class="vx-card vx-prod-card">
          <div class="vx-prod-img-wrap">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'vx-prod-img' }}
            {% else %}
              <div class="vx-prod-img-placeholder">No image</div>
            {% endif %}
            {% if product.tags contains 'best-seller' %}
              <span class="vx-badge" style="position:absolute;top:12px;left:12px;">Best Seller</span>
            {% elsif product.tags contains 'new' %}
              <span class="vx-badge" style="position:absolute;top:12px;left:12px;background:#10B981;">New</span>
            {% endif %}
          </div>
          <div style="padding:16px;">
            <div style="font-size:11px;color:#9CA3AF;font-family:'Inter',sans-serif;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">{{ product.type }}</div>
            <div style="font-weight:700;font-size:15px;color:#0F172A;font-family:'Inter',sans-serif;margin-bottom:8px;">{{ product.title }}</div>
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <span style="font-weight:800;font-size:17px;color:#3B82F6;font-family:'Inter',sans-serif;">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span style="font-size:13px;color:#9CA3AF;text-decoration:line-through;font-family:'Inter',sans-serif;">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
      {% else %}
        <p style="color:#9CA3AF;font-family:'Inter',sans-serif;">No products found. Select a collection in section settings.</p>
      {% endfor %}
    </div>

    {% if section.settings.btn_label != blank %}
      <div style="text-align:center;margin-top:48px;">
        <a href="{{ section.settings.btn_link }}" class="vx-btn-primary" style="background:#3B82F6;padding:14px 32px;font-size:15px;">
          {{ section.settings.btn_label }} →
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .vx-prod-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .vx-prod-card { text-decoration: none; display: block; }
  .vx-prod-img-wrap {
    position: relative;
    aspect-ratio: 1;
    background: #F8FAFC;
    overflow: hidden;
  }
  .vx-prod-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .vx-prod-card:hover .vx-prod-img { transform: scale(1.05); }
  .vx-prod-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9CA3AF;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
  }
  @media (max-width: 989px) { .vx-prod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 479px) { .vx-prod-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
</style>

{% schema %}
{
  "name": "Vennix Featured Products",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR COLLECTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Handpicked essentials for modern living" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Number of products", "min": 2, "max": 8, "step": 2, "default": 4 },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "View All Products" },
    { "type": "url", "id": "btn_link", "label": "Button link", "default": "/collections/all" }
  ],
  "presets": [
    { "name": "Vennix Featured Products" }
  ]
}
{% endschema %}
