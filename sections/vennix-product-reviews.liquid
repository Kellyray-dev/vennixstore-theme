{% comment %}
  Vennix product reviews — a styled, reserved home for a legitimate review app.

  This section deliberately contains NO review content of its own. It renders only the
  app blocks the merchant adds from an installed review app (Shopify Product Reviews,
  Judge.me, Loox, Okendo, ...). No ratings, counts, testimonials or review structured
  data are generated by the theme, so nothing here can become fake social proof.

  With no app block added it renders nothing on the live storefront and shows a
  merchant-facing prompt inside the Theme Editor.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .vx-reviews__heading {
    margin: 0 0 2.4rem;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .vx-reviews__body > * {
    max-width: 100%;
  }

  .vx-reviews__empty {
    margin: 0;
    padding: 2.4rem;
    border: 1px dashed rgba(var(--color-foreground), 0.28);
    color: rgba(var(--color-foreground), 0.65);
    font-size: 1.4rem;
    line-height: 1.6;
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="vx-reviews__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="vx-reviews__body">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="vx-reviews__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <p class="vx-reviews__empty">
        Reserved for customer reviews. Install a review app, then use "Add block" to place its
        review widget here. This section stays hidden on the live storefront until a review app
        block is added — the theme never generates ratings or reviews of its own.
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Vennix product reviews",
  "tag": "section",
  "class": "section section--vennix-reviews",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Reserved space for a review app's block. The theme does not create ratings, review counts or review structured data."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Vennix product reviews"
    }
  ]
}
{% endschema %}
