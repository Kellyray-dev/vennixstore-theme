{{ 'vennix-brand.css' | asset_url | stylesheet_tag }}

<section class="vx-hero" style="background: linear-gradient(135deg, {{ section.settings.bg_color }} 0%, #1E293B 100%); padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;">
  <div class="vx-hero-inner">
    <div class="vx-hero-text">
      {% if section.settings.eyebrow != blank %}
        <span class="vx-eyebrow" style="margin-bottom:12px;display:block;">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 class="vx-heading" style="color:#fff;font-size:clamp(36px,6vw,64px);line-height:1.1;margin-bottom:20px;">
        {{ section.settings.heading }}
      </h1>
      <p style="color:#94A3B8;font-size:16px;line-height:1.7;max-width:520px;margin-bottom:32px;font-family:'Inter',sans-serif;">
        {{ section.settings.subtext }}
      </p>
      <div class="vx-hero-btns">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_link }}" class="vx-btn-primary" style="background:#3B82F6;padding:14px 28px;font-size:15px;">
            {{ section.settings.btn1_label }} →
          </a>
        {% endif %}
        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_link }}" class="vx-btn-secondary" style="color:#fff;border-color:rgba(255,255,255,0.2);padding:14px 28px;font-size:15px;">
            {{ section.settings.btn2_label }}
          </a>
        {% endif %}
      </div>
    </div>
    {% if section.settings.image != blank %}
      <div class="vx-hero-img">
        {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'eager', class: 'vx-hero-img-el' }}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .vx-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }
  .vx-hero-text { flex: 1; max-width: 600px; }
  .vx-hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .vx-hero-img { flex: 1; max-width: 480px; }
  .vx-hero-img-el {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 32px 64px -12px rgba(0,0,0,0.5);
  }
  @media (max-width: 749px) {
    .vx-hero-inner { flex-direction: column; }
    .vx-hero-img { max-width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Vennix Hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#0F172A" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "LIFESTYLE ESSENTIALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate Your Everyday Life" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Discover premium home, tech, and fashion essentials curated for modern living." },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Shop Now" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "View Catalog" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link", "default": "/collections/all" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 40, "max": 160, "step": 8, "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 40, "max": 160, "step": 8, "default": 96 }
  ],
  "presets": [
    { "name": "Vennix Hero" }
  ]
}
{% endschema %}
