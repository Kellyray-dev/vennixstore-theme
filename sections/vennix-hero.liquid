{{ 'section-vennix-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vennix-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign fallback_alt = 'VennixStore — Modern Clothing & Active Essentials'
  assign hero_alt = section.settings.desktop_image.alt | default: fallback_alt
  assign hero_loading = 'eager'
  assign hero_priority = 'high'
  assign free_shipping_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
-%}

<vennix-hero
  class="vennix-hero"
  data-motion="{{ section.settings.enable_motion }}"
  style="--hero-min-height: {{ section.settings.desktop_height }}px; --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-focus: {{ section.settings.image_focus }};"
>
  <section class="vennix-hero__stage" aria-labelledby="VennixHeroHeading-{{ section.id }}">
    <div class="vennix-hero__media-frame" data-hero-media>
      <picture class="vennix-hero__picture">
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 550 }} 550w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {%- endif -%}

        {%- if section.settings.desktop_image != blank -%}
          {{
            section.settings.desktop_image
            | image_url: width: 3000
            | image_tag:
              class: 'vennix-hero__image',
              widths: '750, 1100, 1500, 2000, 2500, 3000',
              sizes: '100vw',
              width: section.settings.desktop_image.width,
              height: section.settings.desktop_image.height,
              alt: hero_alt,
              loading: hero_loading,
              fetchpriority: hero_priority
          }}
        {%- else -%}
          <img
            class="vennix-hero__image"
            src="{{ 'editorial-hero-desktop.jpg' | asset_url }}"
            alt="{{ fallback_alt | escape }}"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </picture>
    </div>

    <div class="vennix-hero__wash" aria-hidden="true"></div>
    <div class="vennix-hero__grain" aria-hidden="true"></div>

    <div class="vennix-hero__inner page-width">
      <div class="vennix-hero__content">
        <div class="vennix-hero__content-backdrop" aria-hidden="true"></div>
        <div class="vennix-hero__content-body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vennix-hero__eyebrow">
            <span class="vennix-hero__eyebrow-mark" aria-hidden="true"></span>
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 id="VennixHeroHeading-{{ section.id }}" class="vennix-hero__heading">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="vennix-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="vennix-hero__actions">
            {%- if section.settings.primary_label != blank -%}
              <a class="button button--primary vennix-hero__button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
                <span>{{ section.settings.primary_label | escape }}</span>
                <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none">
                  <path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_label != blank -%}
              <a class="vennix-hero__text-link link" href="{{ section.settings.secondary_link | default: routes.collections_url }}">
                {{ section.settings.secondary_label | escape }}
                <span aria-hidden="true">↗</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_scroll_cue -%}
        <a class="vennix-hero__scroll" href="#VennixHeroAssurances-{{ section.id }}">
          <span>Discover more</span>
          <svg aria-hidden="true" viewBox="0 0 18 18" width="18" height="18" fill="none">
            <path d="M9 3v11M5 10l4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div id="VennixHeroAssurances-{{ section.id }}" class="vennix-hero__assurances-wrap">
        <ul class="vennix-hero__assurances page-width" role="list" aria-label="Shopping benefits">
          {%- for block in section.blocks -%}
            <li class="vennix-hero__assurance" {{ block.shopify_attributes }}>
              <span class="vennix-hero__assurance-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'delivery' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  {%- when 'returns' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M8 7H4v-4M4.5 7.5A8 8 0 1 1 4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.4"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endcase -%}
              </span>
              <span>
                <strong>{{ block.settings.heading | escape | replace: '[threshold]', free_shipping_amount }}</strong>
                {%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape | replace: '[threshold]', free_shipping_amount }}</small>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </section>
</vennix-hero>

{% schema %}
{
  "name": "Vennix editorial hero",
  "tag": "section",
  "class": "section section--vennix-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Leave blank to use the included Vennix editorial image."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional portrait crop for mobile."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image focus",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 560,
      "max": 860,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 720
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "label": "Image wash",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_motion",
      "label": "Enable subtle image motion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Show scroll cue",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Modern Clothing & Active Essentials"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Modern Clothing. Made for Movement."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Elevated everyday pieces and active essentials designed for modern life.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Explore Essentials"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "blocks": [
    {
      "type": "assurance",
      "name": "Shopping benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "support", "label": "Support" }
          ],
          "default": "secure"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Secure checkout",
          "info": "Use [threshold] to insert the free-shipping threshold from Theme settings > Cart."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vennix editorial hero",
      "blocks": [
        {
          "type": "assurance",
          "settings": {
            "icon": "delivery",
            "heading": "Free shipping over [threshold]",
            "text": "On eligible orders"
          }
        },
        {
          "type": "assurance",
          "settings": {
            "icon": "returns",
            "heading": "30-day returns",
            "text": "Simple and straightforward"
          }
        },
        {
          "type": "assurance",
          "settings": {
            "icon": "secure",
            "heading": "Secure checkout",
            "text": "Protected payments"
          }
        }
      ]
    }
  ]
}
{% endschema %}
