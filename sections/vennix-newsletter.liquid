<section class="vx-newsletter color-{{ section.settings.color_scheme }} gradient">
  <div class="vx-newsletter__inner page-width">
    <div class="vx-newsletter__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vx-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p>{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    <div class="vx-newsletter__form-wrap">
      {% form 'customer', class: 'vx-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="vx-newsletter__field">
          <label class="visually-hidden" for="VennixNewsletter-{{ section.id }}">Email address</label>
          <input
            id="VennixNewsletter-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="VennixNewsletterError-{{ section.id }}"{% endif %}
          >
          <button type="submit">
            <span>{{ section.settings.btn_label | escape }}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        {%- if form.errors -%}
          <small id="VennixNewsletterError-{{ section.id }}" class="vx-newsletter__message" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </small>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="vx-newsletter__message" tabindex="-1" autofocus>{{ section.settings.success_msg | escape }}</p>
        {%- endif -%}
      {% endform %}
      {%- if section.settings.disclaimer != blank -%}
        <small class="vx-newsletter__disclaimer">{{ section.settings.disclaimer | escape }}</small>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vennix newsletter",
  "tag": "section",
  "class": "section section--vennix-newsletter",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Vennix list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New finds, considered updates" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Be first to hear about new arrivals, useful guides, and occasional offers." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Join the list" },
    { "type": "text", "id": "success_msg", "label": "Success message", "default": "Thanks for joining the Vennix list." },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Unsubscribe at any time." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [
    { "name": "Vennix newsletter" }
  ]
}
{% endschema %}
