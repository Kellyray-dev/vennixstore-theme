{{ 'vennix-brand.css' | asset_url | stylesheet_tag }}

<section style="padding:80px 20px;background:{{ section.settings.bg_color }};">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="vx-heading" style="font-size:clamp(28px,4vw,40px);margin-top:8px;">{{ section.settings.heading }}</h2>
    </div>
    <div class="vx-why-grid">
      {% for block in section.blocks %}
        <div class="vx-why-card" {{ block.shopify_attributes }}>
          <div class="vx-why-icon">{{ block.settings.icon }}</div>
          <h3 style="font-family:'Inter',sans-serif;font-weight:700;font-size:18px;color:#0F172A;margin:16px 0 8px;">{{ block.settings.title }}</h3>
          <p style="font-family:'Inter',sans-serif;font-size:14px;color:#9CA3AF;line-height:1.7;margin:0;">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .vx-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .vx-why-card {
    background: #fff;
    border: 1px solid #F3F4F6;
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .vx-why-card:hover {
    box-shadow: 0 12px 24px -8px rgba(15,23,42,0.1);
    transform: translateY(-2px);
  }
  .vx-why-icon {
    font-size: 36px;
    margin-bottom: 4px;
  }
  @media (max-width: 749px) { .vx-why-grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Vennix Why Us",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F8FAFC" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY VENNIX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Us" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🚀" },
        { "type": "text", "id": "title", "label": "Title", "default": "Useful by design" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Everyday products selected for practical features and considered design." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vennix Why Us",
      "blocks": [
        { "type": "reason", "settings": { "icon": "🚀", "title": "Useful by design", "description": "Everyday products selected for practical features and considered design." } },
        { "type": "reason", "settings": { "icon": "💎", "title": "Clear product details", "description": "Straightforward information helps you choose the right product with confidence." } },
        { "type": "reason", "settings": { "icon": "🔒", "title": "Support when needed", "description": "Have a question about an order or product? Contact our support team." } }
      ]
    }
  ]
}
{% endschema %}
