<section class="vx-values color-{{ section.settings.color_scheme }} gradient">
  <div class="vx-values__inner page-width">
    <header class="vx-values__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="vx-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vx-values__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}
        <div class="vx-values__intro rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <ol class="vx-values__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="vx-values__card" {{ block.shopify_attributes }}>
          <span class="vx-values__number" aria-hidden="true">0{{ forloop.index }}</span>
          <div>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.description | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.link_label != blank -%}
      <a class="vx-values__link link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
        {{ section.settings.link_label | escape }}
        <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vennix values",
  "tag": "section",
  "class": "section section--vennix-values",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Vennix approach" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A simpler way to discover what works" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>We bring useful finds across home, technology, style and everyday living into one considered edit.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore all products" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Value",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Useful by design" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Everyday products selected for practical features and considered design." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vennix values",
      "blocks": [
        { "type": "reason", "settings": { "title": "Useful by design", "description": "Everyday products selected for practical features and considered design." } },
        { "type": "reason", "settings": { "title": "Clear product details", "description": "Straightforward information helps you choose with greater confidence." } },
        { "type": "reason", "settings": { "title": "Support when needed", "description": "Questions about an order or product? Our support team is ready to help." } }
      ]
    }
  ]
}
{% endschema %}
