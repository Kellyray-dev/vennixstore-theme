<script src="{{ 'vennix-motion.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ---- Editorial category discovery ------------------------------------ */

  .vx-category-section__header {
    max-width: 64rem;
  }

  .vx-category-section__heading {
    margin: 0;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-size: var(--vennix-type-section, clamp(3.2rem, 4.2vw, 5.2rem));
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .vx-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.6rem, 3vw, 2.4rem);
    margin: var(--vennix-space-opener, 4rem) 0 0;
    list-style: none;
  }

  @media screen and (min-width: 990px) {
    .vx-categories {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1.8rem, 2.2vw, 3rem);
    }
  }

  /* Tile: sharp editorial image with a short centered label — Naadam-style
     category tile. No overlay gradient, no buttons, no border clutter. */
  .vx-category {
    display: block;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }

  .vx-category__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--v-neutral-warm);
  }

  @media screen and (min-width: 750px) {
    .vx-category__media {
      aspect-ratio: 3 / 2.6;
    }
  }

  .vx-category__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: var(--vx-category-focus, center) center;
    transform: scale(1);
    transition: transform 0.55s var(--vennix-motion-ease, cubic-bezier(0.22, 0.61, 0.36, 1));
  }

  .vx-category:hover .vx-category__media img,
  .vx-category:focus-visible .vx-category__media img {
    transform: scale(1.04);
  }

  .vx-category__body {
    display: block;
    padding-top: 1.4rem;
    margin-top: 1.6rem;
    text-align: center;
  }

  .vx-category__title {
    margin: 0;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-size: clamp(1.7rem, 1.3vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .vx-category__tagline {
    display: block;
    margin: 0.7rem auto 0;
    max-width: 30ch;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 1.3rem;
    line-height: 1.55;
  }

  .vx-category__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    padding-bottom: 0.3rem;
    color: rgb(var(--color-foreground));
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .vx-category__cta::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--v-gold-deep);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--vennix-motion-ease, cubic-bezier(0.22, 0.61, 0.36, 1));
  }

  .vx-category__cta {
    position: relative;
  }

  .vx-category:hover .vx-category__cta::after,
  .vx-category:focus-visible .vx-category__cta::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .vx-category__cta svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--v-gold-deep);
    transition: transform var(--vennix-motion-duration-fast, 240ms) var(--vennix-motion-ease, cubic-bezier(0.22, 0.61, 0.36, 1));
  }

  .vx-category:hover .vx-category__cta svg,
  .vx-category:focus-visible .vx-category__cta svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .vx-category__body {
      margin-top: 1.2rem;
      padding-top: 1.2rem;
    }
  }

  .vx-category-section__empty {
    margin: 0;
    padding: 3rem 0;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 1.4rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .vx-category__media img,
    .vx-category__cta::after,
    .vx-category__cta svg {
      transition: none;
      transform: none;
    }
  }
{%- endstyle -%}

{%- liquid
  comment
    Never render an empty shell: with no category blocks configured the section renders
    nothing on the live storefront, and only shows a merchant-facing prompt inside the
    Theme Editor so it stays selectable and configurable.
  endcomment
  assign vx_has_categories = false
  if section.blocks.size > 0
    assign vx_has_categories = true
  endif
-%}

{%- if vx_has_categories == false -%}
  {%- if request.design_mode -%}
    <section class="vx-category-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
      <div class="page-width">
        <p class="vx-category-section__empty">
          Add a category tile block to show this section. It stays hidden on the live
          storefront until at least one tile is configured.
        </p>
      </div>
    </section>
  {%- endif -%}
{%- else -%}
<section
  class="vx-category-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  aria-label="{{ section.settings.heading | default: 'Shop by category' | escape }}"
  data-vx-motion="{{ section.settings.enable_entrance_animation }}"
  style="--vennix-motion-duration: {{ section.settings.motion_duration }}ms;"
>
  <div class="page-width">
    <header class="vx-category-section__header vx-rise">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vx-section-eyebrow">
          <span class="vx-section-eyebrow__mark" aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vx-category-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </header>

    <ul class="vx-categories" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection

          assign block_url = block.settings.link
          if block_url == blank and tile_collection != blank
            assign block_url = tile_collection.url
          endif
          if block_url == blank
            assign block_url = routes.all_products_collection_url
          endif

          assign tile_title = block.settings.title
          if tile_title == blank and tile_collection != blank
            assign tile_title = tile_collection.title
          endif
          if tile_title == blank
            assign tile_title = 'Shop now'
          endif

          assign tile_alt = block.settings.image_alt | default: tile_title
          assign tile_image = block.settings.image
          assign stagger = forloop.index0
          if stagger > 5
            assign stagger = 5
          endif
        -%}
        <li class="vx-categories__item vx-rise" style="--vx-index: {{ stagger }}" {{ block.shopify_attributes }}>
          <a class="vx-category" href="{{ block_url }}">
            <span class="vx-category__media" style="--vx-category-focus: {{ block.settings.image_focus }};">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) calc((100vw - 12rem) / 4), (min-width: 750px) calc((100vw - 8rem) / 2), calc((100vw - 4rem) / 2)',
                    loading: 'lazy',
                    alt: tile_alt | escape
                }}
              {%- elsif tile_collection.featured_image != blank -%}
                {{
                  tile_collection.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) calc((100vw - 12rem) / 4), (min-width: 750px) calc((100vw - 8rem) / 2), calc((100vw - 4rem) / 2)',
                    loading: 'lazy',
                    alt: tile_alt | escape
                }}
              {%- elsif block.settings.image_asset != blank -%}
                <img
                  src="{{ block.settings.image_asset | asset_url }}"
                  alt="{{ tile_alt | escape }}"
                  loading="lazy"
                  width="1408"
                  height="768"
                >
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="vx-category__body">
              <h3 class="vx-category__title">{{ tile_title | escape }}</h3>
              {%- if block.settings.tagline != blank -%}
                <span class="vx-category__tagline">{{ block.settings.tagline | escape }}</span>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <span class="vx-category__cta">
                  {{ block.settings.cta_label | escape }}
                  <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                    <path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Vennix category grid",
  "tag": "section",
  "class": "section section--vennix-categories",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "enable_entrance_animation",
      "label": "Enable entrance animation",
      "default": true,
      "info": "Fade-and-rise reveal for the opener and each tile, with a gentle cascade. Disabled automatically for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "motion_duration",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "ms",
      "label": "Animation duration",
      "default": 550
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Automatically uses the collection's title, image and link. Override below if needed."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional Theme Editor image. Overrides the collection image."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Describe the visible clothing and setting. Leave blank to use the tile title."
        },
        {
          "type": "select",
          "id": "image_focus",
          "label": "Image focus",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Bundled fallback image",
          "info": "Used when no collection or custom image is set. Enter an asset filename from the theme's assets folder. Placeholder — replace with your own photography."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Overrides the collection title."
        },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vennix category grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "image_asset": "womens-fashion.jpg",
            "title": "Women"
          }
        },
        {
          "type": "category",
          "settings": {
            "image_asset": "mens-fashion.jpg",
            "title": "Men"
          }
        },
        {
          "type": "category",
          "settings": {
            "image_asset": "editorial-hero-mobile.jpg",
            "title": "Active"
          }
        },
        {
          "type": "category",
          "settings": {
            "image_asset": "essentials.jpg",
            "title": "Essentials"
          }
        }
      ]
    }
  ]
}
{% endschema %}
