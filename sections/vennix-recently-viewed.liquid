{% comment %}
  App-block host for recently viewed products.

  Shopify does not expose browsing history to Liquid. Keeping this section app-driven
  avoids fake or non-consensual tracking. It stays hidden on the storefront until the
  merchant adds a compatible app block and shows setup guidance only in Theme Editor.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .vx-recently-viewed__heading {
    margin: 0 0 2.4rem;
  }

  .vx-recently-viewed__empty {
    margin: 0;
    padding: 2.4rem;
    border: 1px dashed rgba(var(--color-foreground), 0.28);
    color: rgba(var(--color-foreground), 0.65);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 or request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="vx-recently-viewed__heading h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}
      {%- else -%}
        <p class="vx-recently-viewed__empty">
          Add a recently-viewed app block here. This placeholder stays hidden on the live storefront until configured.
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Vennix recently viewed",
  "tag": "section",
  "class": "section section--vennix-recently-viewed",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a recently-viewed app block. Browsing history is not available to Liquid, so this section intentionally renders no unverified recommendations."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Vennix recently viewed" }]
}
{% endschema %}
