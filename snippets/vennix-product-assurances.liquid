{% comment %}
  Renders the compact purchase-assurance strip on the product page.

  Every claim is derived from real store configuration, never invented:
  - Free shipping is only claimed when the merchant has enabled the free-shipping
    threshold setting AND the visitor's cart currency matches the store currency (the
    threshold is a single-currency figure).
  - Returns and shipping items link to the real Shopify policies and are omitted
    entirely when those policies have not been published, so no dead links appear.
  - Secure checkout describes Shopify checkout itself and makes no absolute claim.

  Usage:
  {%- render 'vennix-product-assurances' -%}
{% endcomment %}

{%- liquid
  assign show_free_shipping = false
  if settings.free_shipping_progress_enabled and settings.free_shipping_threshold > 0 and cart.currency.iso_code == shop.currency
    assign show_free_shipping = true
    assign free_shipping_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
  endif
-%}

<ul class="vx-product-assurances" role="list" aria-label="Purchase benefits">
  {%- if show_free_shipping -%}
    <li>
      {%- if shop.shipping_policy != blank -%}
        <a class="vx-product-assurances__link" href="{{ shop.shipping_policy.url }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          <span>Free shipping<br><small>On orders over {{ free_shipping_amount }} &middot; See shipping policy</small></span>
        </a>
      {%- else -%}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <span>Free shipping<br><small>On orders over {{ free_shipping_amount }}</small></span>
      {%- endif -%}
    </li>
  {%- elsif shop.shipping_policy != blank -%}
    <li>
      <a class="vx-product-assurances__link" href="{{ shop.shipping_policy.url }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <span>Shipping<br><small>See shipping policy</small></span>
      </a>
    </li>
  {%- endif -%}

  {%- if shop.refund_policy != blank -%}
    <li>
      <a
        class="vx-product-assurances__link"
        href="{{ shop.refund_policy.url }}"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M8 7H4V3M4.5 7.5A8 8 0 1 1 4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Returns &amp; refunds<br><small>{{ shop.refund_policy.title | escape }}</small></span>
      </a>
    </li>
  {%- endif -%}

  <li>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.4"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Secure checkout<br><small>Payments processed by Shopify</small></span>
  </li>
</ul>
