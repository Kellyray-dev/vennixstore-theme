{%- liquid
  assign key_features = product.metafields.custom.key_features.value
  if key_features == blank
    assign key_features = product.metafields.custom.highlights.value
  endif

  assign materials = product.metafields.custom.materials
  assign dimensions = product.metafields.custom.dimensions
  assign compatibility = product.metafields.custom.compatibility
  assign care = product.metafields.custom.care_instructions
  assign sizing = product.metafields.custom.sizing_and_fit
  if sizing == blank
    assign sizing = product.metafields.custom.sizing_info
  endif
  assign included = product.metafields.custom.whats_included
  assign warranty = product.metafields.custom.warranty
  assign origin = product.metafields.custom.country_of_origin
  if origin == blank
    assign origin = product.metafields.custom.made_in
  endif

  assign has_specs = false
  if materials != blank or dimensions != blank or compatibility != blank or sizing != blank or included != blank or warranty != blank or origin != blank
    assign has_specs = true
  endif
-%}

{%- if key_features != blank or has_specs -%}
  <div class="product__accordion accordion quick-add-hidden vx-product-accordion">
    <details id="VennixProductDetails-{{ section.id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: 'clipboard' %}
          <h2 class="h4 accordion__title">Details &amp; specifications</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte vx-product-details" id="VennixProductDetailsContent-{{ section.id }}">
        {%- if key_features != blank -%}
          <div class="vx-product-details__features">
            <h3>Highlights</h3>
            <ul role="list">
              {%- for feature in key_features -%}
                <li>
                  <svg aria-hidden="true" viewBox="0 0 18 18" fill="none"><path d="m4 9 3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{{ feature | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if has_specs -%}
          <dl class="vx-product-details__specs">
            {%- if materials != blank -%}
              <div><dt>Materials</dt><dd>{{ materials | metafield_tag }}</dd></div>
            {%- endif -%}
            {%- if dimensions != blank -%}
              <div><dt>Dimensions</dt><dd>{{ dimensions | metafield_tag }}</dd></div>
            {%- endif -%}
            {%- if compatibility != blank -%}
              <div><dt>Compatibility</dt><dd>{{ compatibility | metafield_tag }}</dd></div>
            {%- endif -%}
            {%- if sizing != blank -%}
              <div><dt>Sizing &amp; fit</dt><dd>{{ sizing | metafield_tag }}</dd></div>
            {%- endif -%}
            {%- if included != blank -%}
              <div><dt>What's included</dt><dd>{{ included | metafield_tag }}</dd></div>
            {%- endif -%}
            {%- if warranty != blank -%}
              <div><dt>Warranty</dt><dd>{{ warranty | metafield_tag }}</dd></div>
            {%- endif -%}
            {%- if origin != blank -%}
              <div><dt>Country of origin</dt><dd>{{ origin | metafield_tag }}</dd></div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}

{%- if care != blank -%}
  <div class="product__accordion accordion quick-add-hidden vx-product-accordion">
    <details id="VennixProductCare-{{ section.id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: 'washing' %}
          <h2 class="h4 accordion__title">Care instructions</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="VennixProductCareContent-{{ section.id }}">
        {{ care | metafield_tag }}
      </div>
    </details>
  </div>
{%- endif -%}
