{% comment %}
  Renders the free-shipping progress meter.

  Accepts:
  - layout: {String} 'drawer' (default) or 'page'. 'page' drops the drawer's side margins.

  Usage:
  {%- render 'vennix-shipping-progress', layout: 'page' -%}
{% endcomment %}

{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price | at_least: 0
  assign remaining_amount = remaining_cents | money_with_currency
  comment
    Integer-cents maths only — no float rounding drift. `times: 100` before dividing keeps
    the percentage exact, and `at_most: 100` clamps carts above the threshold.
  endcomment
  assign progress_percent = cart.total_price | times: 100 | divided_by: threshold_cents | at_most: 100 | at_least: 0
  assign currency_matches_store = false
  if cart.currency.iso_code == shop.currency
    assign currency_matches_store = true
  endif
-%}

{%- if settings.free_shipping_progress_enabled and threshold_cents > 0 and currency_matches_store -%}
  <div
    class="vx-shipping-progress{% if layout == 'page' %} vx-shipping-progress--page{% endif %}{% if remaining_cents == 0 %} is-complete{% endif %}"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="vx-shipping-progress__message">
      {%- if remaining_cents == 0 -%}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.4"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ 'vennix.shipping_progress.unlocked_html' | t }}</span>
      {%- else -%}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
        <span>
          {{- 'vennix.shipping_progress.remaining_html' | t: amount: remaining_amount -}}
        </span>
      {%- endif -%}
    </div>
    <div
      class="vx-shipping-progress__track"
      role="progressbar"
      aria-label="{{ 'vennix.shipping_progress.label' | t }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_percent | round }}"
    >
      <span class="vx-shipping-progress__fill" style="width: {{ progress_percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
