{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price | at_least: 0
  assign progress_percent = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100
  assign currency_matches_store = false
  if cart.currency.iso_code == shop.currency
    assign currency_matches_store = true
  endif
-%}

{%- if settings.free_shipping_progress_enabled and threshold_cents > 0 and currency_matches_store and cart.attributes.fulfillment != 'pickup' -%}
  <div class="vx-shipping-progress{% if remaining_cents == 0 %} is-complete{% endif %}" role="status" aria-live="polite">
    <div class="vx-shipping-progress__message">
      {%- if remaining_cents == 0 -%}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.4"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span><strong>Free shipping unlocked!</strong> Your order qualifies.</span>
      {%- else -%}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
        <span>Add <strong>{{ remaining_cents | money_with_currency }}</strong> more for free shipping.</span>
      {%- endif -%}
    </div>
    <div
      class="vx-shipping-progress__track"
      role="progressbar"
      aria-label="Progress toward free shipping"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_percent | round }}"
    >
      <span class="vx-shipping-progress__fill" style="width: {{ progress_percent }}%;"></span>
    </div>

    {%- if remaining_cents > 0 and settings.free_shipping_upsell_product != blank -%}
      {%- assign upsell_product = settings.free_shipping_upsell_product -%}
      {%- assign upsell_variant = upsell_product.selected_or_first_available_variant -%}
      {%- assign in_cart = false -%}
      {%- for item in cart.items -%}
        {%- if item.product_id == upsell_product.id -%}
          {%- assign in_cart = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if upsell_variant.available and in_cart == false -%}
        <div class="vx-shipping-progress__upsell">
          <span class="vx-shipping-progress__upsell-title">Need a boost?</span>
          <product-form class="vx-shipping-progress__upsell-form">
            {%- form 'product', upsell_product, id: 'vx-shipping-upsell-form', class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ upsell_variant.id }}">
              <button
                type="submit"
                name="add"
                class="vx-shipping-progress__upsell-btn"
                aria-label="Add {{ upsell_product.title | escape }} for {{ upsell_variant.price | money_with_currency }}"
              >
                <span>+ Add {{ upsell_product.title | truncate: 22 }} ({{ upsell_variant.price | money }})</span>
              </button>
            {%- endform -%}
          </product-form>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}
