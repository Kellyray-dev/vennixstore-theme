{% comment %}
  Enhanced SEO JSON-LD for VennixStore
  - Full Product with individual variant offers
  - BreadcrumbList on product & collection pages
  - Organization + WebSite (kept from original)
{% endcomment %}

{%- if request.page_type == 'product' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "url": {{ canonical_url | json }},
  "image": [
    {%- for image in product.images limit: 5 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "sku": {{ variant.sku | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  {%- if shop.brand.logo -%}
    "logo": {{ shop.brand.logo | image_url: width: 400 | prepend: 'https:' | json }},
  {%- elsif settings.logo -%}
    "logo": {{ settings.logo | image_url: width: 400 | prepend: 'https:' | json }},
  {%- endif -%}
  "sameAs": [
    {%- assign firstSocial = true -%}
    {%- if settings.social_facebook_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_facebook_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_instagram_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_twitter_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_twitter_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_tiktok_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_youtube_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_pinterest_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_snapchat_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_snapchat_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_tumblr_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_tumblr_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
    {%- if settings.social_vimeo_link != blank -%}
      {%- unless firstSocial -%},{%- endunless -%}
      {{ settings.social_vimeo_link | json }}
      {%- assign firstSocial = false -%}
    {%- endif -%}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
    "urlTemplate": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
